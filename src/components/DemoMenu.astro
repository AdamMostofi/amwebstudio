---
---

<section class="section demo-section" id="demo-menu">
  <div class="container">
    <p class="demo-badge">Live Demos</p>
    <h2 class="section-title">See what we build</h2>
    <p class="section-subtitle">
      Each site is custom-built for the business. Here are three examples
      of what your site could look like.
    </p>

    <div class="demo-grid">

      <div class="demo-card">
        <div class="demo-label">Restaurant Menu</div>
        <div class="demo-img">
          <img
            src="https://images.unsplash.com/photo-1555396273-367ea4eb4db5?auto=format&fit=crop&w=800&q=80"
            alt="Restaurant interior with warm lighting"
            loading="lazy"
          />
        </div>
        <div class="demo-body">
          <div class="demo-menu-head">
            <div>
              <p class="demo-menu-name">Beirut Bistro</p>
              <p class="demo-menu-loc">Gemmayze</p>
            </div>
            <span class="demo-lang">EN / AR</span>
          </div>
          <div class="demo-items">
            <div class="demo-item">
              <div>
                <p class="demo-item-name">Mixed Grill Platter</p>
                <span class="demo-item-desc">Lamb, chicken, rice, garlic dip</span>
              </div>
              <span class="demo-item-price">$18</span>
            </div>
            <div class="demo-item">
              <div>
                <p class="demo-item-name">Fattoush Salad</p>
                <span class="demo-item-desc">Crispy bread, sumac dressing</span>
              </div>
              <span class="demo-item-price">$8</span>
            </div>
            <div class="demo-item">
              <div>
                <p class="demo-item-name">Hummus with Meat</p>
                <span class="demo-item-desc">Creamy hummus, spiced beef</span>
              </div>
              <span class="demo-item-price">$10</span>
            </div>
          </div>
          <div class="demo-cta">
            <span class="demo-btn-green">Order via WhatsApp</span>
          </div>
        </div>
      </div>

      <div class="demo-card demo-clinic">
        <div class="demo-label">Clinic Digital Card</div>
        <div class="demo-body">
          <div class="demo-clinic-head">
            <div class="demo-avatar">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
            </div>
            <div>
              <p class="demo-clinic-name">Dr. Sarah Khalil</p>
              <p class="demo-clinic-spec">General Medicine &bull; Mar Mikhael</p>
            </div>
          </div>
          <div class="demo-clinic-img">
            <img
              src="https://images.unsplash.com/photo-1758691463333-c79215e8bc3b?auto=format&fit=crop&w=600&q=80"
              alt="Doctor in clinic"
              loading="lazy"
            />
          </div>
          <div class="demo-clinic-info">
            <div class="demo-clinic-row">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              <span>Beirut, Lebanon</span>
            </div>
            <div class="demo-clinic-row">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
              <span>Mon-Sat 9AM to 7PM</span>
            </div>
            <div class="demo-clinic-row">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
              <span>+961 3X XXX XXX</span>
            </div>
          </div>
          <div class="demo-cta">
            <span class="demo-btn-primary">Book Appointment</span>
          </div>
        </div>
      </div>

      <div class="demo-card">
        <div class="demo-label">Barbershop Site</div>
        <div class="demo-barber-imgs">
          <img
            src="https://images.unsplash.com/photo-1672257493395-c6cb634397e2?auto=format&fit=crop&w=600&q=80"
            alt="Barbershop interior"
            loading="lazy"
            class="demo-barber-a"
          />
          <img
            src="https://images.unsplash.com/photo-1672257493563-0dac80e22b7d?auto=format&fit=crop&w=400&q=80"
            alt="Barbershop chairs"
            loading="lazy"
            class="demo-barber-b"
          />
        </div>
        <div class="demo-body">
          <p class="demo-barber-name">Classic Cut</p>
          <p class="demo-barber-tag">Barbershop in Hamra</p>
          <p class="demo-barber-desc">Traditional barbering with modern precision. Walk-ins welcome, appointments recommended.</p>
          <div class="demo-cta">
            <span class="demo-btn-primary">Book Now</span>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  .demo-section {

  .demo-badge {
    display: table;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--accent);
    border: 1px solid oklch(55% 0.16 260 / 0.25);
    padding: 4px 14px;
    border-radius: 100px;
    margin: 0 auto 16px;
  }

  .demo-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.9fr 1fr;
    gap: 20px;
    margin-top: 8px;
    align-items: start;
  }

  .demo-card {
    background: var(--surface);
    border-radius: var(--radius-md);
    overflow: hidden;
    border: 1px solid var(--border);
    transition: transform 0.25s var(--ease-out-quart), box-shadow 0.25s var(--ease-out-quart);
  }

  .demo-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 16px 48px oklch(0% 0 0 / 0.3);
  }

  .demo-label {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: var(--text-muted);
    padding: 12px 20px 0;
  }

  .demo-body {
    padding: 16px 20px 20px;
  }

  .demo-cta {
    margin-top: 14px;
    text-align: center;
  }

  .demo-btn-primary {
    display: inline-block;
    background: var(--accent);
    color: var(--text-primary);
    font-size: 0.85rem;
    font-weight: 600;
    padding: 10px 28px;
    border-radius: var(--radius-sm);
    transition: background 0.2s ease-out, transform 0.2s ease-out;
  }

  .demo-btn-primary:hover {
    background: var(--accent-light);
    transform: translateY(-1px);
  }

  .demo-btn-green {
    display: inline-block;
    background: #25d366;
    color: white;
    font-size: 0.85rem;
    font-weight: 600;
    padding: 10px 28px;
    border-radius: var(--radius-sm);
    transition: opacity 0.2s;
  }

  .demo-btn-green:hover {
    opacity: 0.9;
  }

  /* Restaurant */
  .demo-img {
    width: 100%;
    height: 200px;
    overflow: hidden;
  }

  .demo-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.4s var(--ease-out-quart);
  }

  .demo-card:hover .demo-img img {
    transform: scale(1.04);
  }

  .demo-menu-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding-bottom: 12px;
    border-bottom: 1px solid var(--border);
    margin-bottom: 12px;
  }

  .demo-menu-name {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .demo-menu-loc {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .demo-lang {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    letter-spacing: 1px;
  }

  .demo-items {
    display: flex;
    flex-direction: column;
  }

  .demo-item {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    padding: 8px 0;
    border-bottom: 1px dashed var(--border);
  }

  .demo-item:last-child { border-bottom: none; }

  .demo-item-name {
    font-size: 0.88rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 2px;
  }

  .demo-item-desc {
    font-size: 0.78rem;
    color: var(--text-muted);
  }

  .demo-item-price {
    font-size: 0.88rem;
    font-weight: 700;
    color: var(--text-primary);
    flex-shrink: 0;
    margin-left: 12px;
  }

  /* Clinic */
  .demo-clinic-head {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-bottom: 14px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }

  .demo-avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    background: var(--accent-surface);
    color: var(--accent-light);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .demo-clinic-name {
    font-weight: 600;
    color: var(--text-primary);
    font-size: 0.95rem;
  }

  .demo-clinic-spec {
    font-size: 0.8rem;
    color: var(--text-muted);
  }

  .demo-clinic-img {
    width: 100%;
    height: 150px;
    overflow: hidden;
    border-radius: var(--radius-sm);
    margin-bottom: 14px;
  }

  .demo-clinic-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .demo-clinic-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .demo-clinic-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  .demo-clinic-row svg {
    flex-shrink: 0;
    color: var(--accent);
  }

  /* Barber */
  .demo-barber-imgs {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2px;
    padding: 0 2px;
    margin-top: 2px;
  }

  .demo-barber-a {
    width: 100%;
    height: 180px;
    object-fit: cover;
    display: block;
  }

  .demo-barber-b {
    width: 100%;
    height: 100px;
    object-fit: cover;
    display: block;
  }

  .demo-barber-name {
    font-family: var(--font-display);
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .demo-barber-tag {
    font-size: 0.8rem;
    color: var(--text-muted);
    margin-top: 2px;
  }

  .demo-barber-desc {
    font-size: 0.85rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin-top: 8px;
  }

  @media (max-width: 1024px) {
    .demo-grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 600px) {
    .demo-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
